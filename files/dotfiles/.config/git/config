[init]
defaultBranch = trunk

[alias]
graph = "log --decorate --oneline --graph"
st = status
b = branch
c = commit
cl = clone
t = tag

[core]
editor = emacsclient -t -a emacs

[credential]
helper = "cache"

[feature]
manyFiles = false

[commit]
gpgsign = true
template = ~/.config/git/gitmessage

